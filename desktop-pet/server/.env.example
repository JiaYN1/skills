# AI provider. The default is an OpenAI-compatible images API.
AI_ENABLED=true
AI_API_KEY=replace-me
AI_API_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-1
AI_FRAME_COUNT=4
AI_MAX_REFERENCES=2
AI_TIMEOUT_SECONDS=180
REMOVE_BACKGROUND=true
REMBG_MODEL=isnet-general-use
POSE_CONSISTENCY=true
ANIMATION_MODE=hybrid
ANIMATION_FPS=12
WALK_FRAME_COUNT=12
SLEEP_FRAME_COUNT=10

# worker: wait for a Windows worker; archive: only return a zip from Linux.
BUILD_MODE=worker
WORKER_TOKEN=replace-with-a-long-random-token
ADMIN_TOKEN=replace-with-a-separate-admin-token

MAX_FILES=8
MAX_UPLOAD_BYTES=30000000
CORS_ORIGINS=
