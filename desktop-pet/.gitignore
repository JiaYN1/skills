# Packages generated by running the app from this directory. They are user data
# (inputs, prompts, and generated assets), never part of the project, and the
# pet_config.json / animation.json / skeleton.json names are generic enough to
# catch by hand by accident.
/pet_config.json
/animation.json
/skeleton.json
/assets/
/README.txt
/output/
/pets/
