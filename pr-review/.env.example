OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
MAX_DIFF_CHARS=120000

# 大 PR 策略：变更行数超过 LARGE_PR_DIFF_LINES 时改为逐文件检视最关键的 LARGE_PR_MAX_FILES 个文件。
LARGE_PR_DIFF_LINES=500
LARGE_PR_MAX_FILES=5
LARGE_PR_FILE_MAX_CHARS=60000
LARGE_PR_CONCURRENCY=2

# 疑似重复意见的正文相似度阈值（0~1）；1.0 表示只认指纹，不比对正文。
DUPLICATE_SIMILARITY_THRESHOLD=0.7
ACCESS_PASSWORD=
ACCESS_SESSION_SECRET=
ACCESS_SESSION_TTL_SECONDS=2592000

# Optional. Required for private PRs and for publishing review comments.
GITHUB_TOKEN=
GITLAB_TOKEN=
GITCODE_TOKEN=
